{
  "name": "phils",
  "version": "1.0.0",
  "description": "Phils - Intellectual Discovery Feed (Native Android App & Self-Hosted Backend)",
  "scripts": {
    "dev": "npm --prefix server run dev",
    "website:dev": "npx --yes serve website -l 4000",
    "website:open": "start website\\\\index.html",
    "build:server": "npm --prefix server run build",
    "android:build": "cd android && .\\\\gradlew.bat assembleDebug",
    "android:install": "cd android && .\\\\gradlew.bat installDebug",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "philosophy",
    "intellectual-feed",
    "android",
    "jetpack-compose",
    "discovery",
    "self-hosted",
    "recommendation-engine"
  ],
  "author": "",
  "license": "MIT"
}
